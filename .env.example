# ==============================================================================
# KADRO TELEPROMPTER ENVIRONMENT CONFIGURATION (OPEN-SOURCE / SELF-HOSTED)
# ==============================================================================

# Окружение (development или production)
NODE_ENV=production

# Порт Express сервера
PORT=3001

# Telegram Bot Token от @BotFather (опционально для локального теста в браузере)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Публичный HTTPS URL приложения (для Telegram Mini App: домен или ngrok/pinggy)
# Пример для ngrok: https://xxxx-xx-xx.ngrok-free.app
TMA_URL=https://your-domain-or-tunnel.ngrok-free.app

# Deepgram API Key для умного распознавания речи (https://console.deepgram.com/)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Модель Deepgram (например: nova-2, nova-3)
DEEPGRAM_MODEL=nova-2

# Путь к директории базы данных SQLite (в Docker контейнере: /app/data)
DATA_DIR=./data

# Опциональные тексты Telegram-бота
# BOT_START_BUTTON_TEXT=Открыть Телесуфлёр
# BOT_MENU_BUTTON_TEXT=Телесуфлёр
# BOT_START_MESSAGE=Привет! Открой телесуфлёр по кнопке ниже.
